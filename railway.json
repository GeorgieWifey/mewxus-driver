# Mewxus deployment config.
#
# Explicit build context and Dockerfile so Railway does not have to guess, and
# one replica: the preset store is a SQLite file on a single volume, so two
# containers would each hold a different database.

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/up",
    "healthcheckTimeout": 120
  }
}
